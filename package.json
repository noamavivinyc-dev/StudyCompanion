{
  "name": "study-companion",
  "version": "0.3.0",
  "private": true,
  "author": "Noam Avivi",
  "description": "Local-first iPad-aware study assistant for macOS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noamavivinyc-dev/StudyCompanion.git"
  },
  "homepage": "https://github.com/noamavivinyc-dev/StudyCompanion#readme",
  "bugs": {
    "url": "https://github.com/noamavivinyc-dev/StudyCompanion/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "pack": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir --mac",
    "dist:mac:arm64": "npm ci --cpu=arm64 --os=darwin && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac zip --arm64",
    "dist:mac:x64": "npm ci --cpu=x64 --os=darwin && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac zip --x64"
  },
  "dependencies": {
    "@siwc/local": "file:vendor/siwc-local",
    "@huggingface/transformers": "^3.8.1",
    "kokoro-js": "^1.2.1"
  },
  "devDependencies": {
    "electron": "44.5.0",
    "electron-builder": "^26.15.3"
  },
  "overrides": {
    "sharp": "0.35.4"
  },
  "build": {
    "appId": "com.studycompanion.mac",
    "productName": "Study Companion",
    "asar": true,
    "asarUnpack": [
      "node_modules/@huggingface/transformers/**",
      "node_modules/kokoro-js/**",
      "src/asr-worker.mjs",
      "src/tts-worker.mjs"
    ],
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "schemas/**/*",
      "package.json",
      "!node_modules/@huggingface/transformers/.cache/**"
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.education",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Study Companion records lectures and listens for spoken study questions when you choose to record.",
        "NSLocalNetworkUsageDescription": "Study Companion receives your iPad screen over your local network."
      }
    }
  }
}
